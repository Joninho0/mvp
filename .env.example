# Django Configuration
SECRET_KEY=your-secret-key-here-at-least-32-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=bank_db
DB_USER=bank_user
DB_PASSWORD=bank_secret
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# JWT Settings
JWT_SIGNING_KEY=your-jwt-signing-key-here
JWT_ACCESS_TOKEN_LIFETIME=15 minutes
JWT_REFRESH_TOKEN_LIFETIME=7 days

# Security
CRYPTOGRAPHY_KEY=your-encryption-key-here-at-least-32-bytes

# AWS (for optional integration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Monitoring
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:3000